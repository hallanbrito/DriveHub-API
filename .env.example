# Ambiente de Execução (development ou production)
DJANGO_ENV=development

# Chave secreta do Django (obrigatória em produção, não compartilhe)
SECRET_KEY=django-insecure-drivehub-local-dev-key

# Depuração (True para desenvolvimento, False para produção)
DEBUG=True

# Hosts autorizados (separados por vírgula)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Origens autorizadas para CORS (separadas por vírgula, sem barra final)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
